# Aurora Postgres + pgvector (Bedrock Titan v2 = 1024 dims)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jirakb
# database_url is an alias; either name works
# database_url=postgresql://...

# AWS / Bedrock
AWS_REGION=us-east-1
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2
EMBEDDING_DIM=1024
CHAT_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# JIRA Cloud
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=your-api-token
JIRA_JQL_CLOSED=status IN (Closed, Done, Resolved) ORDER BY updated DESC
JIRA_MAX_TICKETS=500
JIRA_APP_CODE=
# ^ optional application code stamped on JIRA rows (see applications table).
#   Leave empty for unscoped, or set per-app ingest runs, e.g. JIRA_APP_CODE=CHECKOUT

# ServiceNow (Table API: incident table, basic auth)
SNOW_INSTANCE_URL=https://your-instance.service-now.com
SNOW_USERNAME=snow-integration-user
SNOW_PASSWORD=your-password
SNOW_ENCODED_QUERY=stateIN6,7^ORDERBYDESCsys_updated_on
SNOW_MAX_INCIDENTS=500
SNOW_APP_CODE=
# ^ optional application code stamped on ServiceNow rows, e.g. SNOW_APP_CODE=CHECKOUT

# Retrieval
TOP_K=8
VECTOR_WEIGHT=0.7
FTS_WEIGHT=0.3

# Chunking
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# Gateway
GATEWAY_PORT=8080
